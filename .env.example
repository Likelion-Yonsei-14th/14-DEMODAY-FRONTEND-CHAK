# Backend API base URL. Leave empty to run on local mock state (prototype mode).
VITE_API_URL=http://localhost:8080

# Kakao REST API key (same app as the backend KAKAO_CLIENT_ID).
VITE_KAKAO_CLIENT_ID=

# Must match the redirect URI registered in Kakao Developers and sent to the backend.
# Defaults to <origin>/auth/kakao/callback when omitted.
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 찰떡 API: mock (default, localStorage) or server (backend /api/chaltteok/*).
VITE_CHALTTEOK_API=mock

# Toss 결제위젯(주문서형·결제창형) client key: test_gck_… / live_gck_….
# Leave empty to charge with a mock button instead of the widget.
# The secret key never goes in this repo - it lives on the backend only.
VITE_TOSS_CLIENT_KEY=
