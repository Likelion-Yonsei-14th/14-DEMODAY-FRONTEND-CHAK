{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://js.tosspayments.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://hangeul.pstatic.net https://cdn.jsdelivr.net; font-src 'self' data: https://unpkg.com https://hangeul.pstatic.net https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://api.tosspayments.com https://*.amazonaws.com; frame-src https://*.tosspayments.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://d1itub0wenvsst.cloudfront.net/api/:path*"
    },
    { "source": "/minigame/exam-career/result/:path*", "destination": "/og/exam-career.html" },
    { "source": "/minigame/d1-course/result/:path*", "destination": "/og/d1-course.html" },
    { "source": "/minigame/study-type/result/:path*", "destination": "/og/study-type.html" },
    { "source": "/minigame/guess-god/result/:path*", "destination": "/og/guess-god.html" },
    { "source": "/promotion", "destination": "/og/promotion.html" },
    { "source": "/desk/:path*", "destination": "/og/desk.html" },
    { "source": "/prototype/claim", "destination": "/og/claim.html" },
    { "source": "/prototype/classroom/:classroomId/join", "destination": "/og/classroom-join.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "chak-put.vercel.app"
        }
      ],
      "destination": "https://www.chak.live/$1",
      "permanent": false
    }
  ]
}
